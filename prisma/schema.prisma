generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  email          String        @unique
  password       String
  role           Role          @default(USER)
  createdAt      DateTime      @default(now())
  organizationId String?       @db.Uuid
  workspaceId    String?       @db.Uuid
  
  // Relationships
  organization   Organization? @relation(fields: [organizationId], references: [id])
  workspace      Workspace?    @relation(fields: [workspaceId], references: [id])
  projects       Project[]
  createdTasks   Task[]        @relation("TaskCreator")
  assignedTasks  TaskAssignee[]
  subTasks       SubTask[]
  comments       Comment[]
  attachments    Attachment[]
  timeLogs       TimeLog[]
  timers         Timer[]
  activities     Activity[]
}

model Organization {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  users       User[]
  projects    Project[]
  workspaces  Workspace[]

  @@map("organizations")
}

model Workspace {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  organizationId String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  // Relationships
  organization   Organization @relation(fields: [organizationId], references: [id])
  users          User[]
  projects       Project[]
  customFields   CustomField[]
  customStatuses CustomStatus[]
  customTypes    CustomType[]

  @@map("workspaces")
}

model Project {
  id                String        @id @default(uuid()) @db.Uuid
  title             String
  description       String?
  createdBy         String?       @db.Uuid
  projectDocument   String?
  userId            String?       @db.Uuid
  projectName       String?
  createdAt         DateTime      @default(now())
  completedAt       DateTime?
  noOfAssignedUsers Int           @default(0)
  organizationId    String?       @db.Uuid
  workspaceId       String?       @db.Uuid
  
  // Relationships
  organization      Organization? @relation(fields: [organizationId], references: [id])
  user              User?         @relation(fields: [userId], references: [id])
  workspace         Workspace?    @relation(fields: [workspaceId], references: [id])
  tasks             Task[]
  customFields      CustomField[]

  @@map("projects")
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  title       String
  description String?
  type        String?   // Task type: bug, feature, story, epic, task, subtask
  dueDate     DateTime?
  priority    Priority  @default(MEDIUM)
  status      Status    @default(TODO)
  customStatus String?
  statusCategory StatusCategory @default(BACKLOG)
  createdAt   DateTime  @default(now())
  createdBy   String    @db.Uuid
  completedAt DateTime?

  // Relationships
  project      Project       @relation(fields: [projectId], references: [id])
  creator      User          @relation("TaskCreator", fields: [createdBy], references: [id])
  assignees    TaskAssignee[]
  subTasks     SubTask[]
  comments     Comment[]
  attachments  Attachment[]
  customFields TaskCustomField[]
  timeLogs     TimeLog[]
  timers       Timer[]

  @@map("tasks")
}

model SubTask {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String?  @db.Uuid
  userId      String?  @db.Uuid
  title       String
  description String?
  attachments String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  task        Task?    @relation(fields: [taskId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String?  @db.Uuid
  userId    String?  @db.Uuid
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task?    @relation(fields: [taskId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@map("comments")
}

model TimeLog {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String?  @db.Uuid
  userId      String?  @db.Uuid
  hoursSpent  Float
  description String?
  logDate     DateTime @default(now())
  createdAt   DateTime @default(now())
  task        Task?    @relation(fields: [taskId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  @@map("time_logs")
}

model Timer {
  id          String    @id @default(uuid()) @db.Uuid
  taskId      String?   @db.Uuid
  userId      String?   @db.Uuid
  description String?
  startedAt   DateTime
  endedAt     DateTime?
  pausedAt    DateTime?
  elapsedTime Float?
  isActive    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  task        Task?     @relation(fields: [taskId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])

  @@map("timers")
}

model Activity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  type      String
  title     String
  message   String
  taskId    String?  @db.Uuid
  projectId String?  @db.Uuid
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@map("activities")
}

model TaskAssignee {
  id     String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  userId String @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_assignees")
}

model Attachment {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @db.Uuid
  fileName    String
  filePath    String
  fileSize    Int
  mimeType    String
  uploadedBy  String   @db.Uuid
  uploadedAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [uploadedBy], references: [id])

  @@map("attachments")
}

model CustomField {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  type        CustomFieldType
  options     String?         // JSON string for dropdown options
  isRequired  Boolean         @default(false)
  workspaceId String?         @db.Uuid
  projectId   String?         @db.Uuid
  createdAt   DateTime        @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  project   Project?   @relation(fields: [projectId], references: [id])
  taskValues TaskCustomField[]

  @@map("custom_fields")
}

model TaskCustomField {
  id            String      @id @default(uuid()) @db.Uuid
  taskId        String      @db.Uuid
  customFieldId String      @db.Uuid
  value         String?     // Store as string, parse based on field type

  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  customField CustomField @relation(fields: [customFieldId], references: [id])

  @@unique([taskId, customFieldId])
  @@map("task_custom_fields")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum Status {
  TODO
  IN_PROGRESS
  DONE
}

// New enum for status categories
enum StatusCategory {
  BACKLOG
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CustomFieldType {
  TEXT
  NUMBER
  DROPDOWN
  BOOLEAN
}

// Custom Status model for workspace-specific custom statuses
model CustomStatus {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  color          String?
  category       StatusCategory
  workspaceId    String        @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  
  workspace      Workspace     @relation(fields: [workspaceId], references: [id])
  
  @@unique([name, workspaceId])
  @@map("custom_statuses")
}

// Custom Type model for workspace-specific custom task types
model CustomType {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  color          String?
  workspaceId    String        @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  
  workspace      Workspace     @relation(fields: [workspaceId], references: [id])
  
  @@unique([name, workspaceId])
  @@map("custom_types")
}
