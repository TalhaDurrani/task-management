generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(uuid()) @db.Uuid
  name             String
  email            String             @unique
  password         String
  role             Role               @default(MEMBER)
  createdAt        DateTime           @default(now())
  workspaceId      String?            @db.Uuid
  subTasks         SubTask[]
  workspace        Workspace?         @relation("WorkspaceMembers", fields: [workspaceId], references: [id])
  activities       Activity[]
  attachments      Attachment[]
  comments         Comment[]
  projects         Project[]
  assignedTasks    TaskAssignee[]
  createdTasks     Task[]             @relation("TaskCreator")
  timeLogs         TimeLog[]
  timers           Timer[]
  ownedWorkspaces  Workspace[]        @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  workflows        Workflow[]
}

model Workspace {
  id             String             @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  ownerId        String             @db.Uuid
  joinCode       String             @unique
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  members        User[]             @relation("WorkspaceMembers")
  customFields   CustomField[]
  customStatuses CustomStatus[]
  customTypes    CustomType[]
  projects       Project[]
  taskTemplates  TaskTemplate[]
  owner          User               @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  workspaceMembers WorkspaceMember[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  workspaceId String    @db.Uuid
  role        Role      @default(MEMBER)
  joinedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

model Project {
  id                String        @id @default(uuid()) @db.Uuid
  title             String
  description       String?
  createdBy         String?       @db.Uuid
  projectDocument   String?
  userId            String?       @db.Uuid
  projectName       String?
  createdAt         DateTime      @default(now())
  completedAt       DateTime?
  noOfAssignedUsers Int           @default(0)
  workspaceId       String?       @db.Uuid
  customFields      CustomField[]
  taskTemplates     TaskTemplate[]
  user              User?         @relation(fields: [userId], references: [id])
  workspace         Workspace?    @relation(fields: [workspaceId], references: [id])
  tasks             Task[]
  workflows         Workflow[]

  @@map("projects")
}

model Task {
  id             String            @id @default(uuid()) @db.Uuid
  projectId      String            @db.Uuid
  title          String
  description    String?
  type           String?
  dueDate        DateTime?
  priority       Priority          @default(MEDIUM)
  status         Int               @default(1) // 1=TODO, 2=IN_PROGRESS, 3=DONE
  customStatus   String?
  statusCategory StatusCategory    @default(BACKLOG)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdBy      String            @db.Uuid
  completedAt    DateTime?
  subTasks       SubTask[]
  attachments    Attachment[]
  comments       Comment[]
  assignees      TaskAssignee[]
  customFields   TaskCustomField[]
  creator        User              @relation("TaskCreator", fields: [createdBy], references: [id])
  project        Project           @relation(fields: [projectId], references: [id])
  timeLogs       TimeLog[]
  timers         Timer[]

  @@map("tasks")
}

model SubTask {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String?  @db.Uuid
  userId      String?  @db.Uuid
  title       String
  description String?
  attachments String?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  task        Task?    @relation(fields: [taskId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String?  @db.Uuid
  userId    String?  @db.Uuid
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task?    @relation(fields: [taskId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@map("comments")
}

model TimeLog {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String?  @db.Uuid
  userId      String?  @db.Uuid
  hoursSpent  Float
  description String?
  logDate     DateTime @default(now())
  createdAt   DateTime @default(now())
  task        Task?    @relation(fields: [taskId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  @@map("time_logs")
}

model Timer {
  id          String    @id @default(uuid()) @db.Uuid
  taskId      String?   @db.Uuid
  userId      String?   @db.Uuid
  description String?
  startedAt   DateTime
  endedAt     DateTime?
  pausedAt    DateTime?
  elapsedTime Float?
  isActive    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  task        Task?     @relation(fields: [taskId], references: [id])
  user        User?     @relation(fields: [userId], references: [id]) 

  @@map("timers")
}

model Activity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  type      String
  title     String
  message   String
  taskId    String?  @db.Uuid
  projectId String?  @db.Uuid
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@map("activities")
}

model TaskAssignee {
  id     String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  userId String @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_assignees")
}

model Attachment {
  id         String   @id @default(uuid()) @db.Uuid
  taskId     String   @db.Uuid
  fileName   String
  filePath   String
  fileSize   Int
  mimeType   String
  uploadedBy String   @db.Uuid
  uploadedAt DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [uploadedBy], references: [id])

  @@map("attachments")
}

model CustomField {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  type        CustomFieldType
  description String?
  options     String?           // JSON array for DROPDOWN, MULTI_SELECT, CHECKBOX options
  defaultValue String?
  placeholder String?
  isRequired  Boolean           @default(false)
  isGlobal    Boolean           @default(false) // Global = available across all projects
  min         Float?            // For NUMBER, RATING validation
  max         Float?            // For NUMBER, RATING validation
  pattern     String?           // Regex pattern for TEXT, EMAIL, URL validation
  workspaceId String?           @db.Uuid
  projectId   String?           @db.Uuid
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  project     Project?          @relation(fields: [projectId], references: [id])
  workspace   Workspace?        @relation(fields: [workspaceId], references: [id])
  taskValues  TaskCustomField[]

  @@map("custom_fields")
}

model TaskCustomField {
  id            String      @id @default(uuid()) @db.Uuid
  taskId        String      @db.Uuid
  customFieldId String      @db.Uuid
  value         String?
  customField   CustomField @relation(fields: [customFieldId], references: [id])
  task          Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, customFieldId])
  @@map("task_custom_fields")
}

model CustomStatus {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  color       String?
  category    StatusCategory
  workspaceId String         @db.Uuid
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id])

  @@unique([name, workspaceId])
  @@map("custom_statuses")
}

model CustomType {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  color       String?
  workspaceId String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([name, workspaceId])
  @@map("custom_types")
}

model TaskTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  type        String   // Task type (bug, feature, story, etc.)
  priority    Priority @default(MEDIUM)
  workspaceId String   @db.Uuid
  projectId   String?  @db.Uuid
  templateData String  // JSON with default values, custom fields, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  project     Project?  @relation(fields: [projectId], references: [id])

  @@map("task_templates")
}

enum Role {
  MEMBER
  ADMIN
}

enum StatusCategory {
  BACKLOG
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CustomFieldType {
  TEXT
  NUMBER
  DROPDOWN
  MULTI_SELECT
  BOOLEAN
  DATE
  USER
  EMAIL
  URL
  TEXTAREA
  CHECKBOX
  RATING
}

model Workflow {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  userId      String   @db.Uuid
  name        String
  columns     Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId, name])
  @@map("workflows")
}
